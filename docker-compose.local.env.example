# Docker Compose local overrides for the public frontend gateway stack.
# Copy this file to `docker-compose.local.env` and fill in the secret values locally.

POSTGREST_PORT=3002
ADMINER_PORT=8088
WEB_PORT=3000
WEB_LIVE_PORT=3300
CONTENT_GATEWAY_PORT=5100
VITE_CONTENT_GATEWAY_BROWSER_URL=http://127.0.0.1:5100

# Existing Docker-hosted Guben database on the host machine
PGRST_DB_URI=postgres://guben:VeryStrongPassword123@host.docker.internal:55432/Guben

# Optional public service overrides
VITE_BOOKING_LOGIN=https://booking.guben.de/login/sso
VITE_BOOKING_SDK=https://booking.guben.de/cdn/current/booking-manager.min.js
VITE_BOOKING_URL=https://backend.booking.guben.de
VITE_MASTERPORTAL_URL=https://masterportal.guben.de/
VITE_MATOMO_JS=https://matomo.guben.de/js/container_Rgw4mNRZ.js
VITE_TRANSLATE_URL=https://translate.guben.de/translate
VITE_TRANSLATE_API_KEY=REPLACE_WITH_TRANSLATE_API_KEY

# Required Smart Village upstream for the postgrest-backed event gateway
SV_GRAPHQL_URL=https://bb-guben.server.smart-village.app/graphql
SV_OAUTH_TOKEN_URL=https://bb-guben.server.smart-village.app/oauth/token
SV_CLIENT_ID=REPLACE_WITH_APPLICATION_ID
SV_CLIENT_SECRET=REPLACE_WITH_APPLICATION_SECRET
