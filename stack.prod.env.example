# ── Legacy ───────────────────────────────────────────────────────────────────

# Produktionsvariablen fuer `stack.prod.yml`

CONTAINER_REGISTRY=ghcr.io/smart-village-solutions/
VERSION_WEB=v0.8.16       # Frontend + Content-Gateway
VERSION_API=v0.7.3        # .NET API – bleibt auf letztem bekannten Stand

FRONTEND_BASEURI=https://cockpit.guben.de
# Optional fuer Subdomain-Variante (wenn externer API-Host genutzt wird):
# CONTENT_GATEWAY_PUBLIC_URL=https://api.guben.de
# Optional: Upstream fuer Booking-Proxy im Web-Container
INTERNAL_BOOKING_URL=https://backend.booking.guben.de

# .NET API
DATABASE_CONNECTION_STRING=Server=guben-db-prod;Port=5432;Database=Guben;User Id=Guben;Password=***;
ProjectImporterBearerToken=***

# Keycloak (für guben-api-prod)
KEYCLOAK_REALM=Guben
KEYCLOAK_AUTH_SERVER=https://keycloak.guben.de
KEYCLOAK_ENABLE_SSL=external
KEYCLOAK_RESOURCE=react-client
KEYCLOAK_VERIFY_AUDIENCE=false

# Datenbank
DATABASE_USERNAME=Guben
DATABASE_PASSWORD=***
DATABASE_NAME=Guben

# Nextcloud
NEXTCLOUD_BASE_URI=https://nextcloud.guben.de
NEXTCLOUD_BASE_DIR=Guben
NEXTCLOUD_USERNAME=guben
NEXTCLOUD_PASSWORD=***

# ── Neuer Stack ───────────────────────────────────────────────────────────────

# PostgREST – Verbindung zur selben DB (Format: postgres://user:password@host:port/dbname)
PGRST_DB_URI=postgres://Guben:***@guben-db-prod:5432/Guben

# Content-Gateway (required for Smart Village event cutover)
MASTERPORTAL_URL=https://masterportal.guben.de/
SV_GRAPHQL_URL=https://bb-guben.server.smart-village.app/graphql
SV_OAUTH_TOKEN_URL=https://bb-guben.server.smart-village.app/oauth/token
SV_CLIENT_ID=***
SV_CLIENT_SECRET=***
